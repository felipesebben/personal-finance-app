# Copy to .env at the repo root and fill in real values:
#   cp .env.example .env
# The backend validates these at startup (backend/config.py) and refuses to
# start, naming the variable, if a required one is missing.

# --- Database (required) ---
DB_USER=finance_user
DB_PASSWORD=
# DB_HOST is the Compose service name; use "localhost" to run the API outside Docker.
DB_HOST=db
# DB_PORT also sets the host port docker-compose.yml maps Postgres to.
DB_PORT=5432
DB_NAME=finance

# --- Auth (required) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Optional, default 30:
# Log out after this many minutes without using the app (the frontend renews the token on use).
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional: comma-separated emails allowed to sign up (case-insensitive).
# Empty or unset = anyone who can reach the app may create an account.
# Set it before opening the app to other devices on your network, e.g.
# ALLOWED_SIGNUP_EMAILS=you@example.com,partner@example.com
# ALLOWED_SIGNUP_EMAILS=

# --- Email / password reset (optional) ---
# "console" (default) prints reset emails to the backend log instead of
# sending them: `docker compose logs backend` shows the link. "smtp" sends.
# EMAIL_BACKEND=console
#
# To send through Gmail: turn on 2-Step Verification for the account, then
# create an App Password at https://myaccount.google.com/apppasswords and
# paste its 16 characters (no spaces) into SMTP_PASSWORD. Your normal Gmail
# password will not work.
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Usually the same Gmail address, e.g. "Personal Finance <you@gmail.com>".
EMAIL_FROM=
# Where reset links point. Use the LAN address (http://<your-ipv4>:8501) so a
# link opened on another device, like a phone, reaches the app.
# FRONTEND_BASE_URL=http://localhost:8501
# How long a reset link works, in minutes (default 30).
# PASSWORD_RESET_EXPIRE_MINUTES=30

# --- pgAdmin (docker-compose only) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=

# --- Tableau Cloud (optional; only needed for POST /refresh) ---
TABLEAU_SERVER_URL=https://your-pod.online.tableau.com
TABLEAU_SITENAME=your-site
TABLEAU_TOKEN_NAME=your-personal-access-token-name
TABLEAU_TOKEN_VALUE=
# The Tableau project the datasources are published into. Default: "Finance App 2026".
# Must match the project your workbook uses, or Refresh publishes elsewhere.
TABLEAU_PROJECT_NAME=Finance App 2026

# --- Frontend (optional) ---
# Where Streamlit reaches the API. docker-compose.yml sets http://backend:8000;
# outside Docker the default is http://localhost:8000.
# API_URL=http://localhost:8000
