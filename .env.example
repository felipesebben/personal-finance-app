# Copy to .env at the repo root and fill in real values:
#   cp .env.example .env
# The backend validates these at startup (backend/config.py) and refuses to
# start, naming the variable, if a required one is missing.

# --- Database (required) ---
DB_USER=finance_user
DB_PASSWORD=
# DB_HOST is the Compose service name; use "localhost" to run the API outside Docker.
DB_HOST=db
# DB_PORT also sets the host port docker-compose.yml maps Postgres to.
DB_PORT=5432
DB_NAME=finance

# --- Auth (required) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Optional, default 30:
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- pgAdmin (docker-compose only) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=

# --- Tableau Cloud (optional; only needed for POST /refresh) ---
TABLEAU_SERVER_URL=https://your-pod.online.tableau.com
TABLEAU_SITENAME=your-site
TABLEAU_TOKEN_NAME=your-personal-access-token-name
TABLEAU_TOKEN_VALUE=
# The Tableau project the datasources are published into. Default: "Finance App 2026".
# Must match the project your workbook uses, or Refresh publishes elsewhere.
TABLEAU_PROJECT_NAME=Finance App 2026

# --- Frontend (optional) ---
# Where Streamlit reaches the API. docker-compose.yml sets http://backend:8000;
# outside Docker the default is http://localhost:8000.
# API_URL=http://localhost:8000
